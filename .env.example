# PostgreSQL local; reemplazar contraseñas. Nunca subir .env.
DATABASE_URL=postgresql://habits_local_app:CAMBIAR@127.0.0.1:55439/habits_local
# Solo para pytest. Base separada, cuyo nombre debe terminar en _test.
TEST_DATABASE_URL=postgresql://habits_test:CAMBIAR@127.0.0.1:55439/habits_test
SECRET_KEY=CAMBIAR_POR_UN_VALOR_ALEATORIO
# development para HTTP local; production obliga a cookies Secure (HTTPS).
HABITS_ENV=development
# Activar explícitamente solo para usar admin / 123 en la demo local.
HABITS_DEMO_LOGIN=0
# Puerto de la página local.
HABITS_PORT=5059
# Opcional: permite que run.py encienda un clúster local que ya existe.
# HABITS_PGDATA=.local/postgres
# HABITS_PG_CTL=C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe
# HABITS_PGPORT=55439
