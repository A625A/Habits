        "dataCategory": "Time",
        "lineageTag": "e6e0bbc0-9c2c-48b4-807e-b6571baca595",
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "expression": [
                "SELECTCOLUMNS (",
                "    CALENDAR (DATE(2025, 11, 1), DATE(2026, 10, 31)),",
                "    \"Fecha\", [Date],",
                "    \"Año\", YEAR([Date]),",
                "    \"Mes\", MONTH([Date]),",
                "    \"Año mes\", YEAR([Date]) * 100 + MONTH([Date]),",
                "    \"Mes año\", FORMAT([Date], \"mmm yyyy\", \"es-GT\")",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
